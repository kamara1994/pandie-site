# ── Supabase (donation ledger database) ────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL is safe to expose — it identifies your project endpoint.
# SUPABASE_SERVICE_ROLE_KEY is a secret — server-side only, never use NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# ── Stripe (card, Apple Pay, Google Pay, recurring) ────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# ── PayPal / Venmo ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=REPLACE_WITH_YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=REPLACE_WITH_YOUR_PAYPAL_WEBHOOK_ID

# CRITICAL: Set to "sandbox" for all testing. Set to "production" ONLY when fully ready.
# Omitting this variable defaults to sandbox — live PayPal requires explicit opt-in.
PAYPAL_ENV=sandbox

# ── Site URL ────────────────────────────────────────────────────────────────────
# Use https://pandiefoundation.org for production, http://localhost:3000 for dev
NEXT_PUBLIC_SITE_URL=https://pandiefoundation.org
